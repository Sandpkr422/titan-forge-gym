{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/gyms/:path*", "destination": "/gyms/:path*" },
    { "source": "/gym/:slug", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}